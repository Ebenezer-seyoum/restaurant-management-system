NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key
SUPABASE_STORAGE_BUCKET=emrakel-images
DATABASE_URL=postgresql://restaurant_user:replace_password@postgres:5432/restaurant
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
AUTH_SECRET=replace_with_a_long_random_secret
COOKIE_DOMAIN=.httpemrakelhouse.com
ADMIN_EMAIL=admin@emrakel.house
ADMIN_PASSWORD=change_this_password
ADMIN_NAME=EMRAKEL Admin
CUSTOMER_EMAIL=customer@emrakel.house
CUSTOMER_PASSWORD=change_this_password
IMAGE_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=emrakel-house
# Alternative to the three credential variables above:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Optional legacy/fallback providers:
AWS_REGION=eu-central-1
AWS_S3_BUCKET=emrakel-images
AWS_S3_PUBLIC_URL=https://your-cloudfront-or-public-s3-url
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
UPLOAD_DIR=/app/public/uploads/admin
UPLOAD_PUBLIC_URL=/uploads/admin
